<Project>
  <!-- cTrader.Automate calculates bundle metadata before standard project properties
       can reliably override it in nested/multi-project layouts. Set the filename and
       metadata paths immediately before extraction so build and publish use CTTraderBot.algo. -->
  <Target Name="FixCTraderAlgoMetadata" BeforeTargets="_ExtractMetadata" Condition="'$(AlgoBuild)' == 'true'">
    <PropertyGroup>
      <_AlgoFileName>$(AlgoName).algo</_AlgoFileName>
      <_AlgoFilePath>$(OutDir)$(_AlgoFileName)</_AlgoFilePath>
      <_AlgoMetadataFileName>$(_AlgoFileName).metadata</_AlgoMetadataFileName>
      <_AlgoMetadataFilePath>$(OutDir)$(_AlgoMetadataFileName)</_AlgoMetadataFilePath>
    </PropertyGroup>
  </Target>
</Project>
